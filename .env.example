# === Discord ===
DISCORD_TOKEN=isi_token_bot
CLIENT_ID=isi_application_id_bot
# Isi GUILD_ID agar slash command langsung muncul di server itu (disarankan).
# Kosongkan untuk mendaftarkan command secara global (butuh waktu hingga ~1 jam).
GUILD_ID=

# === Roblox ===
ROBLOX_GROUP_ID=625247444
# Ganti ke roproxy.com kalau VPS kamu sering gagal/diblokir saat akses API Roblox langsung.
ROBLOX_DOMAIN=roblox.com
# Universe ID map yang tidak mau ditampilkan, pisahkan koma (opsional).
EXCLUDE_UNIVERSE_IDS=
# Urutan card: visits | playing | name | updated
SORT_BY=visits

# === Tampilan card ===
EMBED_COLOR=#E53935
FOOTER_TEXT=Update setiap 1 hari • Made by KokoKrunch Studios

# === Jadwal update ===
UPDATE_INTERVAL_HOURS=24
